diff --git a/src/OpenGMK/gm8emulator/src/render/opengl/sdl_gl.rs b/src/OpenGMK/gm8emulator/src/render/opengl/sdl_gl.rs
new file mode 100644
index 0000000..9766234
--- /dev/null
+++ b/src/OpenGMK/gm8emulator/src/render/opengl/sdl_gl.rs
@@ -0,0 +1,107 @@
+//! GL context creation through SDL2, for Trimui and similar handhelds (OpenGL ES, no X11/EGL by hand).
+//!
+//! The window is made by ramen's SDL2 backend, with GLES 3.0 attributes already requested. Here
+//! we only create the context on that window and load entry points with `SDL_GL_GetProcAddress`.
+//! Mirrors `egl.rs`, minus everything that existed because of Android's surface lifecycle.
+
+use std::{
+    ffi::{c_char, c_int, c_void, CString},
+    sync::Mutex,
+};
+
+use ramen::{connection::Connection, window::Window};
+use sdl2lite::Sdl;
+
+extern "C" fn no_op_fn() {}
+
+/// Entry points stubbed out because GLES doesn't have them.
+static MISSING_FNS: Mutex<Vec<&'static str>> = Mutex::new(Vec::new());
+
+/// Prints the stubbed entry points once, so they show up in the log without flooding it.
+pub fn log_stubbed_once() {
+    static ONCE: std::sync::OnceLock<()> = std::sync::OnceLock::new();
+    let _ = ONCE.get_or_init(|| {
+        let list: Vec<String> = MISSING_FNS.lock().unwrap().iter().map(|s| s.to_string()).collect();
+        if !list.is_empty() {
+            eprintln!("[gl] ausentes, sustituidas por no-ops: {}", list.join(", "));
+        }
+    });
+}
+
+pub struct PlatformImpl {
+    sdl: &'static Sdl,
+    window: *mut c_void,
+    context: *mut c_void,
+}
+
+impl PlatformImpl {
+    /// Creates the GLES context on the window and makes it current.
+    pub unsafe fn new(connection: &Connection, window: &Window) -> Result<Self, String> {
+        let _ = connection;
+        let sdl = sdl2lite::get()?;
+        let win = window.xid();
+        if win.is_null() {
+            return Err("ramen no entrego una ventana SDL".into())
+        }
+        // The loading screen already made a context for this window: keep using it.
+        let context = match sdl2lite::splash::context_for(win) {
+            Some(context) => context,
+            None => {
+                let context = (sdl.gl_create_context)(win);
+                if context.is_null() {
+                    return Err(format!("SDL_GL_CreateContext fallo: {}", sdl2lite::last_error(sdl)))
+                }
+                context
+            },
+        };
+        if (sdl.gl_make_current)(win, context) != 0 {
+            let err = sdl2lite::last_error(sdl);
+            (sdl.gl_delete_context)(context);
+            return Err(format!("SDL_GL_MakeCurrent fallo: {}", err))
+        }
+        // Vsync on; the game's frame limiter does the rest.
+        let _ = (sdl.gl_set_swap_interval)(1);
+        Ok(Self { sdl, window: win, context })
+    }
+
+    pub unsafe fn get_function_loader() -> Result<Box<dyn FnMut(&'static str) -> *const c_void>, String> {
+        let sdl = sdl2lite::get()?;
+        Ok(Box::new(move |name: &'static str| {
+            let Ok(cname) = CString::new(name) else { return no_op_fn as *const c_void };
+            let mut ptr = unsafe { (sdl.gl_get_proc_address)(cname.as_ptr() as *const c_char) } as *const c_void;
+            if ptr.is_null() {
+                // Desktop-only entry points that GLES doesn't provide. Rather than let gl_generator's
+                // fallback abort the game, point at a no-op and report them.
+                MISSING_FNS.lock().unwrap().push(name);
+                ptr = no_op_fn as *const c_void;
+            }
+            ptr
+        }))
+    }
+
+    pub unsafe fn clean_function_loader() {
+        log_stubbed_once();
+    }
+
+    pub unsafe fn swap_buffers(&self) {
+        (self.sdl.gl_swap_window)(self.window);
+    }
+
+    pub unsafe fn set_swap_interval(&self, n: u32) -> bool {
+        (self.sdl.gl_set_swap_interval)(n as c_int) == 0
+    }
+
+    pub unsafe fn get_swap_interval(&self) -> u32 {
+        (self.sdl.gl_get_swap_interval)().max(0) as u32
+    }
+
+    pub unsafe fn wait_vsync(&self) {
+        // swap_buffers already waits for vsync.
+    }
+}
+
+impl Drop for PlatformImpl {
+    fn drop(&mut self) {
+        unsafe { (self.sdl.gl_delete_context)(self.context) };
+    }
+}
