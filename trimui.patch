diff --git a/src/OpenGMK/gm8emulator/src/game/audio/sdl_audio.rs b/src/OpenGMK/gm8emulator/src/game/audio/sdl_audio.rs
new file mode 100644
index 0000000..08cdb5e
--- /dev/null
+++ b/src/OpenGMK/gm8emulator/src/game/audio/sdl_audio.rs
@@ -0,0 +1,106 @@
+//! Audio output through SDL2 (Trimui and other handhelds without PulseAudio/JACK).
+//!
+//! Same idea as `aaudio.rs`: the engine feeds a `Mixer`, and here an SDL audio device pulls from it
+//! straight from SDL's own audio thread. SDL is loaded with `dlopen` (see the `sdl2lite` crate), so
+//! the binary uses whatever `libSDL2` the console ships.
+
+use std::{
+    ffi::{c_int, c_void},
+    ptr,
+    sync::{
+        atomic::{AtomicU32, Ordering},
+        Arc, Mutex,
+    },
+};
+
+use sdl2lite::{AudioSpec, AUDIO_F32SYS, SDL_INIT_AUDIO};
+use udon::source::{ChannelCount, Sample, SampleRate, Source};
+
+use super::mixer::{Mixer, MixerHandle};
+
+/// SDL_AUDIO_ALLOW_FREQUENCY_CHANGE | SDL_AUDIO_ALLOW_CHANNELS_CHANGE | SDL_AUDIO_ALLOW_SAMPLES_CHANGE
+const ALLOW_CHANGES: c_int = 0x1 | 0x4 | 0x8;
+
+/// The mixer currently being pulled by the SDL callback, if any.
+static MIXER: Mutex<Option<Mixer>> = Mutex::new(None);
+
+/// The SDL audio device id (0 = none), so the output can be paused and resumed.
+static DEVICE: AtomicU32 = AtomicU32::new(0);
+
+/// Stops or resumes the output.
+pub fn set_paused(paused: bool) {
+    let dev = DEVICE.load(Ordering::Relaxed);
+    if dev == 0 {
+        return
+    }
+    if let Ok(sdl) = sdl2lite::get() {
+        unsafe { (sdl.pause_audio_device)(dev, paused as c_int) };
+    }
+}
+
+/// Fills `len` bytes of interleaved f32 audio from the mixer. SDL calls this from its own audio
+/// thread, so a failed `try_lock` just yields silence instead of blocking it.
+unsafe extern "C" fn data_callback(_userdata: *mut c_void, stream: *mut u8, len: c_int) {
+    let samples = (len.max(0) as usize) / std::mem::size_of::<Sample>();
+    let buffer = std::slice::from_raw_parts_mut(stream as *mut Sample, samples);
+    match MIXER.try_lock() {
+        Ok(mut guard) => match guard.as_mut() {
+            Some(mixer) => {
+                let written = mixer.write_samples(buffer);
+                if written < samples {
+                    buffer[written..].iter_mut().for_each(|x| *x = 0.0);
+                }
+            },
+            None => buffer.iter_mut().for_each(|x| *x = 0.0),
+        },
+        Err(_) => buffer.iter_mut().for_each(|x| *x = 0.0),
+    }
+}
+
+/// Opens the output and hands the mixer over to its callback. Returns the device id (kept alive for
+/// the life of the process), the channel count, the sample rate, and the handle used to add sounds.
+pub fn open(global_volume: Arc<AtomicU32>) -> Result<(usize, ChannelCount, SampleRate, MixerHandle), String> {
+    let sdl = sdl2lite::get()?;
+    unsafe {
+        if (sdl.init_sub_system)(SDL_INIT_AUDIO) != 0 {
+            return Err(format!("SDL_InitSubSystem(audio) fallo: {}", sdl2lite::last_error(sdl)))
+        }
+
+        let want = AudioSpec {
+            freq: 48000,
+            format: AUDIO_F32SYS,
+            channels: 2,
+            silence: 0,
+            samples: 1024,
+            padding: 0,
+            size: 0,
+            callback: Some(data_callback),
+            userdata: ptr::null_mut(),
+        };
+        let mut have = AudioSpec::zeroed();
+        let dev = (sdl.open_audio_device)(ptr::null(), 0, &want, &mut have, ALLOW_CHANGES);
+        if dev == 0 {
+            return Err(format!("SDL_OpenAudioDevice fallo: {}", sdl2lite::last_error(sdl)))
+        }
+        if have.format != AUDIO_F32SYS {
+            return Err(format!("SDL no entrego audio f32 (formato 0x{:x})", have.format))
+        }
+
+        let channels = ChannelCount::new(u16::from(have.channels.max(1))).ok_or("canal de audio invalido")?;
+        let sample_rate = SampleRate::new(have.freq.max(8000) as u32).ok_or("frecuencia de audio invalida")?;
+
+        let (mixer, handle) = Mixer::new(sample_rate, channels, global_volume);
+        *MIXER.lock().unwrap() = Some(mixer);
+        DEVICE.store(dev, Ordering::Relaxed);
+
+        // SDL devices start paused.
+        (sdl.pause_audio_device)(dev, 0);
+        eprintln!(
+            "[sdl-audio] salida abierta: {} canales @ {} Hz, buffer de {} muestras",
+            channels.get(),
+            sample_rate.get(),
+            have.samples
+        );
+        Ok((dev as usize, channels, sample_rate, handle))
+    }
+}
