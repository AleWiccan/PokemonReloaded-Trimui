@@ -0,0 +1,226 @@
+//! Enlace minimo a SDL2, cargado con `dlopen` en tiempo de ejecucion.
+//!
+//! No hay dependencia en tiempo de enlace: el binario usa la `libSDL2` de la propia consola
+//! (la de Trimui, con su driver de video `mali`), que se encuentra mediante `LD_LIBRARY_PATH`.
+
+use std::{
+    ffi::{c_char, c_int, c_void, CStr, CString},
+    sync::OnceLock,
+};
+
+pub mod splash;
+
+pub const SDL_INIT_AUDIO: u32 = 0x0000_0010;
+pub const SDL_INIT_VIDEO: u32 = 0x0000_0020;
+pub const SDL_INIT_JOYSTICK: u32 = 0x0000_0200;
+pub const SDL_INIT_EVENTS: u32 = 0x0000_4000;
+
+pub const SDL_WINDOWPOS_UNDEFINED: c_int = 0x1FFF_0000;
+pub const SDL_WINDOW_FULLSCREEN_DESKTOP: u32 = 0x0000_1001;
+pub const SDL_WINDOW_OPENGL: u32 = 0x0000_0002;
+pub const SDL_WINDOW_SHOWN: u32 = 0x0000_0004;
+
+pub const SDL_GL_RED_SIZE: c_int = 0;
+pub const SDL_GL_GREEN_SIZE: c_int = 1;
+pub const SDL_GL_BLUE_SIZE: c_int = 2;
+pub const SDL_GL_ALPHA_SIZE: c_int = 3;
+pub const SDL_GL_DEPTH_SIZE: c_int = 6;
+pub const SDL_GL_STENCIL_SIZE: c_int = 7;
+pub const SDL_GL_CONTEXT_MAJOR_VERSION: c_int = 17;
+pub const SDL_GL_CONTEXT_MINOR_VERSION: c_int = 18;
+pub const SDL_GL_CONTEXT_PROFILE_MASK: c_int = 21;
+pub const SDL_GL_CONTEXT_PROFILE_ES: c_int = 0x0004;
+
+pub const AUDIO_F32SYS: u16 = 0x8120;
+
+// Tipos de evento (SDL_EventType)
+pub const SDL_QUIT: u32 = 0x100;
+pub const SDL_WINDOWEVENT: u32 = 0x200;
+pub const SDL_KEYDOWN: u32 = 0x300;
+pub const SDL_KEYUP: u32 = 0x301;
+pub const SDL_JOYAXISMOTION: u32 = 0x600;
+pub const SDL_JOYHATMOTION: u32 = 0x602;
+pub const SDL_JOYBUTTONDOWN: u32 = 0x603;
+pub const SDL_JOYBUTTONUP: u32 = 0x604;
+pub const SDL_JOYDEVICEADDED: u32 = 0x605;
+pub const SDL_JOYDEVICEREMOVED: u32 = 0x606;
+
+// SDL_WindowEventID
+pub const SDL_WINDOWEVENT_SIZE_CHANGED: u8 = 6;
+pub const SDL_WINDOWEVENT_FOCUS_GAINED: u8 = 12;
+pub const SDL_WINDOWEVENT_FOCUS_LOST: u8 = 13;
+pub const SDL_WINDOWEVENT_CLOSE: u8 = 14;
+
+pub const SDL_HAT_UP: u8 = 1;
+pub const SDL_HAT_RIGHT: u8 = 2;
+pub const SDL_HAT_DOWN: u8 = 4;
+pub const SDL_HAT_LEFT: u8 = 8;
+
+/// `SDL_Event` es una union de 56 bytes. Se lee por desplazamientos, que son estables en SDL2.
+#[repr(C, align(8))]
+#[derive(Clone, Copy)]
+pub struct Event {
+    pub raw: [u8; 56],
+}
+
+impl Event {
+    pub const fn zeroed() -> Self {
+        Self { raw: [0; 56] }
+    }
+    pub fn kind(&self) -> u32 {
+        self.u32_at(0)
+    }
+    pub fn u32_at(&self, off: usize) -> u32 {
+        u32::from_ne_bytes([self.raw[off], self.raw[off + 1], self.raw[off + 2], self.raw[off + 3]])
+    }
+    pub fn i32_at(&self, off: usize) -> i32 {
+        self.u32_at(off) as i32
+    }
+    pub fn i16_at(&self, off: usize) -> i16 {
+        i16::from_ne_bytes([self.raw[off], self.raw[off + 1]])
+    }
+    pub fn u8_at(&self, off: usize) -> u8 {
+        self.raw[off]
+    }
+}
+
+#[repr(C)]
+pub struct AudioSpec {
+    pub freq: c_int,
+    pub format: u16,
+    pub channels: u8,
+    pub silence: u8,
+    pub samples: u16,
+    pub padding: u16,
+    pub size: u32,
+    pub callback: Option<unsafe extern "C" fn(userdata: *mut c_void, stream: *mut u8, len: c_int)>,
+    pub userdata: *mut c_void,
+}
+
+impl AudioSpec {
+    pub const fn zeroed() -> Self {
+        Self {
+            freq: 0,
+            format: 0,
+            channels: 0,
+            silence: 0,
+            samples: 0,
+            padding: 0,
+            size: 0,
+            callback: None,
+            userdata: std::ptr::null_mut(),
+        }
+    }
+}
+
+macro_rules! sdl_api {
+    ( $( $field:ident = $sym:literal : fn($($arg:ty),*) $(-> $ret:ty)? ; )* ) => {
+        /// Tabla de funciones de SDL2 resueltas con `dlsym`.
+        pub struct Sdl {
+            $( pub $field: unsafe extern "C" fn($($arg),*) $(-> $ret)?, )*
+        }
+
+        impl Sdl {
+            unsafe fn load(lib: *mut c_void) -> Result<Self, String> {
+                Ok(Self {
+                    $( $field: {
+                        let p = libc::dlsym(lib, concat!($sym, "\0").as_ptr().cast());
+                        if p.is_null() {
+                            return Err(format!("libSDL2 no tiene el simbolo {}", $sym))
+                        }
+                        std::mem::transmute::<*mut c_void, unsafe extern "C" fn($($arg),*) $(-> $ret)?>(p)
+                    }, )*
+                })
+            }
+        }
+    };
+}
+
+sdl_api! {
+    init_sub_system = "SDL_InitSubSystem": fn(u32) -> c_int;
+    get_error = "SDL_GetError": fn() -> *const c_char;
+    get_current_video_driver = "SDL_GetCurrentVideoDriver": fn() -> *const c_char;
+    create_window = "SDL_CreateWindow": fn(*const c_char, c_int, c_int, c_int, c_int, u32) -> *mut c_void;
+    destroy_window = "SDL_DestroyWindow": fn(*mut c_void);
+    get_window_size = "SDL_GetWindowSize": fn(*mut c_void, *mut c_int, *mut c_int);
+    set_window_title = "SDL_SetWindowTitle": fn(*mut c_void, *const c_char);
+    show_cursor = "SDL_ShowCursor": fn(c_int) -> c_int;
+    gl_set_attribute = "SDL_GL_SetAttribute": fn(c_int, c_int) -> c_int;
+    gl_create_context = "SDL_GL_CreateContext": fn(*mut c_void) -> *mut c_void;
+    gl_delete_context = "SDL_GL_DeleteContext": fn(*mut c_void);
+    gl_make_current = "SDL_GL_MakeCurrent": fn(*mut c_void, *mut c_void) -> c_int;
+    gl_swap_window = "SDL_GL_SwapWindow": fn(*mut c_void);
+    gl_set_swap_interval = "SDL_GL_SetSwapInterval": fn(c_int) -> c_int;
+    gl_get_swap_interval = "SDL_GL_GetSwapInterval": fn() -> c_int;
+    gl_get_proc_address = "SDL_GL_GetProcAddress": fn(*const c_char) -> *mut c_void;
+    gl_get_drawable_size = "SDL_GL_GetDrawableSize": fn(*mut c_void, *mut c_int, *mut c_int);
+    poll_event = "SDL_PollEvent": fn(*mut Event) -> c_int;
+    num_joysticks = "SDL_NumJoysticks": fn() -> c_int;
+    joystick_open = "SDL_JoystickOpen": fn(c_int) -> *mut c_void;
+    joystick_name = "SDL_JoystickName": fn(*mut c_void) -> *const c_char;
+    open_audio_device = "SDL_OpenAudioDevice": fn(*const c_char, c_int, *const AudioSpec, *mut AudioSpec, c_int) -> u32;
+    pause_audio_device = "SDL_PauseAudioDevice": fn(u32, c_int);
+}
+
+// SAFETY: son punteros a funciones de una biblioteca que no se descarga nunca.
+unsafe impl Send for Sdl {}
+unsafe impl Sync for Sdl {}
+
+static SDL: OnceLock<Result<Sdl, String>> = OnceLock::new();
+
+/// Carga `libSDL2` (una sola vez) y devuelve su tabla de funciones.
+pub fn get() -> Result<&'static Sdl, String> {
+    SDL.get_or_init(|| unsafe {
+        for name in ["libSDL2-2.0.so.0", "libSDL2.so", "libSDL2-2.0.so"] {
+            let c = CString::new(name).unwrap();
+            let lib = libc::dlopen(c.as_ptr(), libc::RTLD_NOW | libc::RTLD_GLOBAL);
+            if !lib.is_null() {
+                return Sdl::load(lib)
+            }
+        }
+        Err("no se pudo cargar libSDL2 (revisa LD_LIBRARY_PATH)".to_string())
+    })
+    .as_ref()
+    .map_err(|e| e.clone())
+}
+
+/// Ultimo error de SDL como `String`.
+pub fn last_error(sdl: &Sdl) -> String {
+    unsafe {
+        let p = (sdl.get_error)();
+        if p.is_null() {
+            String::new()
+        } else {
+            CStr::from_ptr(p).to_string_lossy().into_owned()
+        }
+    }
+}
+
+/// Creates the fullscreen OpenGL ES window used by the game (and by the loading screen).
+///
+/// The GL attributes have to be set before the window exists. The window is always fullscreen at
+/// the desktop size: these screens have no window manager.
+pub fn create_gl_window(sdl: &Sdl, title: &str) -> Result<*mut c_void, String> {
+    let title = CString::new(title.replace('\0', "")).unwrap_or_default();
+    let attrs: [(c_int, c_int); 9] = [
+        (SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES),
+        (SDL_GL_CONTEXT_MAJOR_VERSION, 3),
+        (SDL_GL_CONTEXT_MINOR_VERSION, 0),
+        (SDL_GL_RED_SIZE, 8),
+        (SDL_GL_GREEN_SIZE, 8),
+        (SDL_GL_BLUE_SIZE, 8),
+        (SDL_GL_ALPHA_SIZE, 8),
+        (SDL_GL_DEPTH_SIZE, 24),
+        (SDL_GL_STENCIL_SIZE, 8),
+    ];
+    for (attr, value) in attrs {
+        let _ = unsafe { (sdl.gl_set_attribute)(attr, value) };
+    }
+    let flags = SDL_WINDOW_SHOWN | SDL_WINDOW_OPENGL | SDL_WINDOW_FULLSCREEN_DESKTOP;
+    let handle = unsafe { (sdl.create_window)(title.as_ptr(), 0, 0, 1280, 720, flags) };
+    if handle.is_null() {
+        return Err(format!("SDL_CreateWindow: {}", last_error(sdl)))
+    }
+    let _ = unsafe { (sdl.show_cursor)(0) };
+    Ok(handle)
+}
diff --git a/vendor/sdl2lite/src/splash.rs b/vendor/sdl2lite/src/splash.rs
new file mode 100644
index 0000000..7b9497e
--- /dev/null
+++ b/vendor/sdl2lite/src/splash.rs
@@ -0,0 +1,338 @@
+//! Minimal loading screen.
+//!
+//! Loading a big game takes up to a minute on the console and, until the engine draws its first
+//! frame, the screen shows nothing, which looks like a freeze. This module puts a window up right
+//! at the start and draws a title, a short message and a progress bar, using nothing but
+//! `glClear` + `glScissor` (no shaders, no textures, no files): the text comes from a tiny 5x7
+//! bitmap font built into the code.
+//!
+//! The window and the GL context created here are handed over to the engine (ramen and the
+//! renderer adopt them), so there is no second window. `update` keeps working after the handover,
+//! and restores the GL state it touches, until `finish` is called.
+
+use std::{
+    ffi::{c_char, c_int, c_void},
+    sync::{Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+
+use crate::{Sdl, SDL_INIT_EVENTS, SDL_INIT_VIDEO};
+
+type GlClearColor = unsafe extern "C" fn(f32, f32, f32, f32);
+type GlClear = unsafe extern "C" fn(u32);
+type GlCap = unsafe extern "C" fn(u32);
+type GlRect = unsafe extern "C" fn(c_int, c_int, c_int, c_int);
+type GlGetFloatv = unsafe extern "C" fn(u32, *mut f32);
+type GlGetIntegerv = unsafe extern "C" fn(u32, *mut c_int);
+type GlIsEnabled = unsafe extern "C" fn(u32) -> u8;
+type GlBindFramebuffer = unsafe extern "C" fn(u32, u32);
+
+const GL_COLOR_BUFFER_BIT: u32 = 0x4000;
+const GL_SCISSOR_TEST: u32 = 0x0C11;
+const GL_SCISSOR_BOX: u32 = 0x0C10;
+const GL_VIEWPORT: u32 = 0x0BA2;
+const GL_COLOR_CLEAR_VALUE: u32 = 0x0C22;
+const GL_DRAW_FRAMEBUFFER_BINDING: u32 = 0x8CA6;
+const GL_READ_FRAMEBUFFER_BINDING: u32 = 0x8CAA;
+const GL_FRAMEBUFFER: u32 = 0x8D40;
+const GL_READ_FRAMEBUFFER: u32 = 0x8CA8;
+const GL_DRAW_FRAMEBUFFER: u32 = 0x8CA9;
+
+struct Gl {
+    clear_color: GlClearColor,
+    clear: GlClear,
+    enable: GlCap,
+    disable: GlCap,
+    scissor: GlRect,
+    viewport: GlRect,
+    get_floatv: GlGetFloatv,
+    get_integerv: GlGetIntegerv,
+    is_enabled: GlIsEnabled,
+    bind_framebuffer: GlBindFramebuffer,
+}
+
+struct State {
+    sdl: &'static Sdl,
+    window: *mut c_void,
+    context: *mut c_void,
+    gl: Gl,
+    w: c_int,
+    h: c_int,
+}
+
+// SAFETY: only ever used from the thread that drives the game; the mutex just guards the static.
+unsafe impl Send for State {}
+
+static STATE: Mutex<Option<State>> = Mutex::new(None);
+static T0: OnceLock<Instant> = OnceLock::new();
+/// When the screen was last redrawn, to throttle `progress`.
+static LAST_DRAW: Mutex<Option<Instant>> = Mutex::new(None);
+/// Minimum time between two redraws caused by `progress`: drawing must not slow the loading down.
+const PROGRESS_INTERVAL: Duration = Duration::from_millis(300);
+
+macro_rules! gl_fn {
+    ($sdl:expr, $name:literal, $ty:ty) => {{
+        let cname = concat!($name, "\0");
+        let p = unsafe { ($sdl.gl_get_proc_address)(cname.as_ptr() as *const c_char) };
+        if p.is_null() {
+            return Err(format!("falta {}", $name))
+        }
+        unsafe { std::mem::transmute::<*mut c_void, $ty>(p) }
+    }};
+}
+
+fn load_gl(sdl: &Sdl) -> Result<Gl, String> {
+    Ok(Gl {
+        clear_color: gl_fn!(sdl, "glClearColor", GlClearColor),
+        clear: gl_fn!(sdl, "glClear", GlClear),
+        enable: gl_fn!(sdl, "glEnable", GlCap),
+        disable: gl_fn!(sdl, "glDisable", GlCap),
+        scissor: gl_fn!(sdl, "glScissor", GlRect),
+        viewport: gl_fn!(sdl, "glViewport", GlRect),
+        get_floatv: gl_fn!(sdl, "glGetFloatv", GlGetFloatv),
+        get_integerv: gl_fn!(sdl, "glGetIntegerv", GlGetIntegerv),
+        is_enabled: gl_fn!(sdl, "glIsEnabled", GlIsEnabled),
+        bind_framebuffer: gl_fn!(sdl, "glBindFramebuffer", GlBindFramebuffer),
+    })
+}
+
+fn try_start() -> Result<(), String> {
+    let sdl = crate::get()?;
+    if unsafe { (sdl.init_sub_system)(SDL_INIT_VIDEO | SDL_INIT_EVENTS) } != 0 {
+        return Err(format!("SDL_InitSubSystem: {}", crate::last_error(sdl)))
+    }
+    let window = crate::create_gl_window(sdl, "Cargando")?;
+    let fail = |msg: String| -> Result<(), String> {
+        unsafe { (sdl.destroy_window)(window) };
+        Err(msg)
+    };
+
+    let context = unsafe { (sdl.gl_create_context)(window) };
+    if context.is_null() {
+        return fail(format!("SDL_GL_CreateContext: {}", crate::last_error(sdl)))
+    }
+    if unsafe { (sdl.gl_make_current)(window, context) } != 0 {
+        unsafe { (sdl.gl_delete_context)(context) };
+        return fail(format!("SDL_GL_MakeCurrent: {}", crate::last_error(sdl)))
+    }
+    // No vsync here: waiting for it on every redraw would only slow the loading down.
+    let _ = unsafe { (sdl.gl_set_swap_interval)(0) };
+    let gl = match load_gl(sdl) {
+        Ok(gl) => gl,
+        Err(e) => {
+            unsafe { (sdl.gl_delete_context)(context) };
+            return fail(e)
+        },
+    };
+
+    let (mut w, mut h): (c_int, c_int) = (0, 0);
+    unsafe { (sdl.gl_get_drawable_size)(window, &mut w, &mut h) };
+    if w <= 0 || h <= 0 {
+        unsafe { (sdl.get_window_size)(window, &mut w, &mut h) };
+    }
+    if w <= 0 || h <= 0 {
+        w = 1280;
+        h = 720;
+    }
+
+    *STATE.lock().unwrap() = Some(State { sdl, window, context, gl, w, h });
+    Ok(())
+}
+
+/// Opens the window and the GL context and draws the first frame. Best effort: if anything fails
+/// there is simply no loading screen, and the engine creates its own window as usual.
+pub fn start() {
+    let _ = T0.get_or_init(Instant::now);
+    if let Err(e) = try_start() {
+        eprintln!("[carga] sin pantalla de carga: {}", e);
+    } else {
+        update("INICIANDO", 0.0);
+    }
+}
+
+/// Redraws the screen with a message (ASCII, it is uppercased) and a progress between 0 and 1.
+/// Also logs the elapsed time, to see which stage takes longest.
+pub fn update(label: &str, progress: f32) {
+    let secs = T0.get().map(|t| t.elapsed().as_secs_f32()).unwrap_or(0.0);
+    eprintln!("[carga] {:6.1} s  {:>3.0}%  {}", secs, progress.clamp(0.0, 1.0) * 100.0, label);
+    draw_now(label, progress);
+}
+
+/// Like `update`, but meant for loops: it does not log, and it redraws at most every 300 ms.
+pub fn progress(label: &str, progress: f32) {
+    if let Ok(mut last) = LAST_DRAW.lock() {
+        if let Some(t) = *last {
+            if t.elapsed() < PROGRESS_INTERVAL {
+                return
+            }
+        }
+        *last = Some(Instant::now());
+    }
+    draw_now_unthrottled(label, progress);
+}
+
+fn draw_now(label: &str, progress: f32) {
+    if let Ok(mut last) = LAST_DRAW.lock() {
+        *last = Some(Instant::now());
+    }
+    draw_now_unthrottled(label, progress);
+}
+
+fn draw_now_unthrottled(label: &str, progress: f32) {
+    if let Ok(guard) = STATE.lock() {
+        if let Some(st) = guard.as_ref() {
+            unsafe { draw(st, label, progress) };
+        }
+    }
+}
+
+/// The window made by the loading screen, if there is one, so the engine reuses it.
+pub fn window() -> Option<*mut c_void> {
+    STATE.lock().ok()?.as_ref().map(|st| st.window)
+}
+
+/// The GL context made by the loading screen for `window`, if it is the same window.
+pub fn context_for(window: *mut c_void) -> Option<*mut c_void> {
+    STATE.lock().ok()?.as_ref().filter(|st| st.window == window).map(|st| st.context)
+}
+
+/// Stops drawing. Call it once the engine is about to draw its own frames.
+pub fn finish() {
+    if let Ok(mut guard) = STATE.lock() {
+        *guard = None;
+    }
+}
+
+const BG: [f32; 3] = [0.07, 0.07, 0.10];
+const TITLE: [f32; 3] = [0.95, 0.95, 0.95];
+const LABEL: [f32; 3] = [0.65, 0.65, 0.72];
+const TRACK: [f32; 3] = [0.20, 0.20, 0.26];
+const FILL: [f32; 3] = [0.95, 0.78, 0.20];
+
+unsafe fn rect(st: &State, x: i32, y: i32, w: i32, h: i32, c: [f32; 3]) {
+    if w <= 0 || h <= 0 {
+        return
+    }
+    (st.gl.scissor)(x, st.h - y - h, w, h);
+    (st.gl.clear_color)(c[0], c[1], c[2], 1.0);
+    (st.gl.clear)(GL_COLOR_BUFFER_BIT);
+}
+
+fn text_width(s: &str, scale: i32) -> i32 {
+    (s.chars().count() as i32 * 6 * scale - scale).max(0)
+}
+
+unsafe fn text(st: &State, x: i32, y: i32, scale: i32, s: &str, c: [f32; 3]) {
+    let mut cx = x;
+    for ch in s.chars() {
+        let g = glyph(ch);
+        for (row, bits) in g.iter().enumerate() {
+            let mut col: i32 = 0;
+            while col < 5 {
+                if *bits & (0b10000u8 >> col) != 0 {
+                    let start = col;
+                    while col < 5 && *bits & (0b10000u8 >> col) != 0 {
+                        col += 1;
+                    }
+                    rect(st, cx + start * scale, y + row as i32 * scale, (col - start) * scale, scale, c);
+                } else {
+                    col += 1;
+                }
+            }
+        }
+        cx += 6 * scale;
+    }
+}
+
+unsafe fn text_centered(st: &State, y: i32, scale: i32, s: &str, c: [f32; 3]) {
+    text(st, (st.w - text_width(s, scale)) / 2, y, scale, s, c);
+}
+
+unsafe fn draw(st: &State, label: &str, progress: f32) {
+    let gl = &st.gl;
+
+    // The engine renders the game into its own offscreen framebuffer and keeps it bound, so draw
+    // into the window's framebuffer (0) instead, and give the engine's back afterwards.
+    let (mut fbo_draw, mut fbo_read): (c_int, c_int) = (0, 0);
+    (gl.get_integerv)(GL_DRAW_FRAMEBUFFER_BINDING, &mut fbo_draw);
+    (gl.get_integerv)(GL_READ_FRAMEBUFFER_BINDING, &mut fbo_read);
+    (gl.bind_framebuffer)(GL_FRAMEBUFFER, 0);
+
+    // Remember what we touch, because after the handover the engine owns the GL state.
+    let (mut vp, mut sc, mut cc) = ([0 as c_int; 4], [0 as c_int; 4], [0f32; 4]);
+    (gl.get_integerv)(GL_VIEWPORT, vp.as_mut_ptr());
+    (gl.get_integerv)(GL_SCISSOR_BOX, sc.as_mut_ptr());
+    (gl.get_floatv)(GL_COLOR_CLEAR_VALUE, cc.as_mut_ptr());
+    let scissor_was_on = (gl.is_enabled)(GL_SCISSOR_TEST) != 0;
+
+    (gl.viewport)(0, 0, st.w, st.h);
+    (gl.enable)(GL_SCISSOR_TEST);
+
+    let s = (st.w / 160).max(2);
+    rect(st, 0, 0, st.w, st.h, BG);
+    text_centered(st, st.h * 30 / 100, s, "CARGANDO", TITLE);
+    text_centered(st, st.h * 47 / 100, (s / 2).max(1), &label.to_ascii_uppercase(), LABEL);
+
+    let (bw, bh) = (st.w / 2, s * 2);
+    let (bx, by) = ((st.w - bw) / 2, st.h * 62 / 100);
+    rect(st, bx, by, bw, bh, TRACK);
+    rect(st, bx, by, (bw as f32 * progress.clamp(0.0, 1.0)) as i32, bh, FILL);
+
+    text_centered(st, st.h * 80 / 100, (s / 2).max(1), "PUEDE TARDAR HASTA UN MINUTO", LABEL);
+
+    (st.sdl.gl_swap_window)(st.window);
+
+    (gl.bind_framebuffer)(GL_DRAW_FRAMEBUFFER, fbo_draw as u32);
+    (gl.bind_framebuffer)(GL_READ_FRAMEBUFFER, fbo_read as u32);
+    (gl.viewport)(vp[0], vp[1], vp[2], vp[3]);
+    (gl.scissor)(sc[0], sc[1], sc[2], sc[3]);
+    (gl.clear_color)(cc[0], cc[1], cc[2], cc[3]);
+    if !scissor_was_on {
+        (gl.disable)(GL_SCISSOR_TEST);
+    }
+}
+
+/// 5x7 glyphs, one byte per row, bit 4 is the leftmost column. Only what the messages need.
+fn glyph(c: char) -> [u8; 7] {
+    match c.to_ascii_uppercase() {
+        'A' => [0b01110, 0b10001, 0b10001, 0b11111, 0b10001, 0b10001, 0b10001],
+        'B' => [0b11110, 0b10001, 0b10001, 0b11110, 0b10001, 0b10001, 0b11110],
+        'C' => [0b01110, 0b10001, 0b10000, 0b10000, 0b10000, 0b10001, 0b01110],
+        'D' => [0b11110, 0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b11110],
+        'E' => [0b11111, 0b10000, 0b10000, 0b11110, 0b10000, 0b10000, 0b11111],
+        'F' => [0b11111, 0b10000, 0b10000, 0b11110, 0b10000, 0b10000, 0b10000],
+        'G' => [0b01110, 0b10001, 0b10000, 0b10111, 0b10001, 0b10001, 0b01111],
+        'H' => [0b10001, 0b10001, 0b10001, 0b11111, 0b10001, 0b10001, 0b10001],
+        'I' => [0b01110, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100, 0b01110],
+        'J' => [0b00111, 0b00010, 0b00010, 0b00010, 0b00010, 0b10010, 0b01100],
+        'K' => [0b10001, 0b10010, 0b10100, 0b11000, 0b10100, 0b10010, 0b10001],
+        'L' => [0b10000, 0b10000, 0b10000, 0b10000, 0b10000, 0b10000, 0b11111],
+        'M' => [0b10001, 0b11011, 0b10101, 0b10101, 0b10001, 0b10001, 0b10001],
+        'N' => [0b10001, 0b11001, 0b10101, 0b10011, 0b10001, 0b10001, 0b10001],
+        'O' => [0b01110, 0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b01110],
+        'P' => [0b11110, 0b10001, 0b10001, 0b11110, 0b10000, 0b10000, 0b10000],
+        'Q' => [0b01110, 0b10001, 0b10001, 0b10001, 0b10101, 0b10010, 0b01101],
+        'R' => [0b11110, 0b10001, 0b10001, 0b11110, 0b10100, 0b10010, 0b10001],
+        'S' => [0b01111, 0b10000, 0b10000, 0b01110, 0b00001, 0b00001, 0b11110],
+        'T' => [0b11111, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100],
+        'U' => [0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b01110],
+        'V' => [0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b01010, 0b00100],
+        'W' => [0b10001, 0b10001, 0b10001, 0b10101, 0b10101, 0b10101, 0b01010],
+        'X' => [0b10001, 0b10001, 0b01010, 0b00100, 0b01010, 0b10001, 0b10001],
+        'Y' => [0b10001, 0b10001, 0b01010, 0b00100, 0b00100, 0b00100, 0b00100],
+        'Z' => [0b11111, 0b00001, 0b00010, 0b00100, 0b01000, 0b10000, 0b11111],
+        '0' => [0b01110, 0b10001, 0b10011, 0b10101, 0b11001, 0b10001, 0b01110],
+        '1' => [0b00100, 0b01100, 0b00100, 0b00100, 0b00100, 0b00100, 0b01110],
+        '2' => [0b01110, 0b10001, 0b00001, 0b00010, 0b00100, 0b01000, 0b11111],
+        '3' => [0b11110, 0b00001, 0b00001, 0b01110, 0b00001, 0b00001, 0b11110],
+        '4' => [0b00010, 0b00110, 0b01010, 0b10010, 0b11111, 0b00010, 0b00010],
+        '5' => [0b11111, 0b10000, 0b11110, 0b00001, 0b00001, 0b10001, 0b01110],
+        '6' => [0b00110, 0b01000, 0b10000, 0b11110, 0b10001, 0b10001, 0b01110],
+        '7' => [0b11111, 0b00001, 0b00010, 0b00100, 0b01000, 0b01000, 0b01000],
+        '8' => [0b01110, 0b10001, 0b10001, 0b01110, 0b10001, 0b10001, 0b01110],
+        '9' => [0b01110, 0b10001, 0b10001, 0b01111, 0b00001, 0b00010, 0b01100],
+        '.' => [0b00000, 0b00000, 0b00000, 0b00000, 0b00000, 0b01100, 0b01100],
+        '-' => [0b00000, 0b00000, 0b00000, 0b11111, 0b00000, 0b00000, 0b00000],
+        _ => [0; 7],
+    }
+}
