+# Controles de Pokemon Reloaded en Trimui (Smart Pro).
+#
+# FORMATO   entrada = TECLA
+#   b<N>            boton N del mando                    b1 = Z
+#   a<N>+  a<N>-    eje N empujado en positivo/negativo  a2+ = Space
+#   hat-up hat-down hat-left hat-right   cruceta
+#   shift+<entrada> = TECLA   segunda capa: valido mientras se mantiene el boton "shift"
+#   shift = b<N>    boton que activa la segunda capa. Si se pulsa y se suelta SIN usar
+#                   ninguna otra entrada, envia su propia tecla de la capa normal (un "toque").
+# Teclas validas: A-Z, 0-9, F1-F12, Enter, Esc, Space, Up, Down, Left, Right, Tab, Backspace
+#
+# Los numeros de boton/eje dependen de la consola. Con un archivo vacio "debug.on" en la
+# carpeta del port, log.txt anota cada pulsacion ("[input] boton 3 abajo", "[input] eje 1- activo").
+# Si este archivo tiene al menos una linea valida, REEMPLAZA por completo la tabla por defecto.
+
+# ---- capa normal ----
+b1 = Z           # A
+b0 = X           # B
+b2 = C           # X
+b3 = V           # Y   (bicicleta / ver)
+b4 = B           # L1  sacar Pokemon
+b5 = A           # R1  objeto asignado
+a2+ = Space      # L2  Pokemon
+a5+ = O          # R2  mochila
+b7 = Enter       # Start  menu
+b8 = Esc         # Menu   salir
+b6 = M           # Select mapa (toque corto; mantenido es el Shift)
+
+hat-up = Up
+hat-down = Down
+hat-left = Left
+hat-right = Right
+
+# palanca izquierda = flechas (eje 0 = horizontal, eje 1 = vertical; arriba es a1-)
+a1- = Up
+a1+ = Down
+a0- = Left
+a0+ = Right
+
+# palanca derecha (eje 3 = horizontal, eje 4 = vertical; arriba es a4-)
+a4- = S          # arriba     cambio en combate
+a4+ = E          # abajo      escapar en combate
+a3- = F          # izquierda  flauta / buscar
+a3+ = P          # derecha    porcentaje de captura / menu entrenador
+
+# ---- capa 2: mantener Select ----
+shift = b6
+shift+hat-up = 1
+shift+hat-right = 2
+shift+hat-down = 3
+shift+hat-left = 4
+shift+b1 = 5     # A
+shift+b0 = 6     # B
+shift+b2 = 7     # X
+shift+b3 = 8     # Y
+shift+b4 = 9     # L1
+shift+b5 = F8    # R1  smartphone
+shift+a5+ = Q    # R2  misiones
+
+# palanca derecha con Select mantenido
+shift+a4- = F12  # arriba     Pokedex
+shift+a4+ = D    # abajo      dar objeto
+shift+a3- = L    # izquierda  estilo de menu / ubicaciones en la Pokedex
+shift+a3+ = K    # derecha    color de menu
diff --git a/vendor/ramen/src/platform/sdl2.rs b/vendor/ramen/src/platform/sdl2.rs
new file mode 100644
index 0000000..c7f74d9
--- /dev/null
+++ b/vendor/ramen/src/platform/sdl2.rs
@@ -0,0 +1,563 @@
+//! SDL2 backend for ramen (Trimui and other handhelds with no X11/Wayland).
+//!
+//! The window and the GL context come from the device's own `libSDL2`, loaded at run time with
+//! `dlopen` (see the `sdl2lite` crate). Input comes from the gamepad (raw joystick API) and is
+//! turned into keyboard events, because the game only understands keys.
+//!
+//! The button layout can be changed without recompiling through `controls.ini` (see
+//! [`Controls::load`]); the path can be overridden with `TRIMUI_CONTROLS`.
+
+use std::{
+    ffi::{c_char, c_int, c_void, CString},
+    sync::{
+        atomic::{AtomicU32, Ordering},
+        Mutex, OnceLock,
+    },
+};
+
+use sdl2lite::Sdl;
+
+use crate::{error::Error, event::Event, input::Key, window::Builder};
+
+/// Stand-in for X11's `Display`, which this backend does not have.
+#[repr(C)]
+pub struct Display {
+    _opaque: [u8; 0],
+}
+
+static WIN_W: AtomicU32 = AtomicU32::new(0);
+static WIN_H: AtomicU32 = AtomicU32::new(0);
+
+/// Size of the SDL window in pixels (0, 0 until the window has been created).
+pub fn window_size() -> (u32, u32) {
+    (WIN_W.load(Ordering::Relaxed), WIN_H.load(Ordering::Relaxed))
+}
+
+fn sdl() -> Result<&'static Sdl, Error> {
+    sdl2lite::get().map_err(|e| Error::Text(e.into()))
+}
+
+fn sdl_err(what: &str, s: &Sdl) -> Error {
+    Error::Text(format!("{}: {}", what, sdl2lite::last_error(s)).into())
+}
+
+// ---------------------------------------------------------------------------------------------
+// Controls
+// ---------------------------------------------------------------------------------------------
+
+const LETTERS: [Key; 26] = [
+    Key::A, Key::B, Key::C, Key::D, Key::E, Key::F, Key::G, Key::H, Key::I, Key::J, Key::K, Key::L, Key::M,
+    Key::N, Key::O, Key::P, Key::Q, Key::R, Key::S, Key::T, Key::U, Key::V, Key::W, Key::X, Key::Y, Key::Z,
+];
+
+const DIGITS: [Key; 10] = [
+    Key::Alpha0, Key::Alpha1, Key::Alpha2, Key::Alpha3, Key::Alpha4,
+    Key::Alpha5, Key::Alpha6, Key::Alpha7, Key::Alpha8, Key::Alpha9,
+];
+
+const FUNCTION_KEYS: [Key; 12] = [
+    Key::F1, Key::F2, Key::F3, Key::F4, Key::F5, Key::F6, Key::F7, Key::F8, Key::F9, Key::F10, Key::F11, Key::F12,
+];
+
+/// Default layout, also shipped as `controls.ini` next to the port.
+const DEFAULT_INI: &str = include_str!("controls_default.ini");
+
+fn parse_key(name: &str) -> Option<Key> {
+    let n = name.trim().to_ascii_lowercase();
+    if n.len() == 1 {
+        let c = n.as_bytes()[0];
+        if c.is_ascii_lowercase() {
+            return Some(LETTERS[(c - b'a') as usize])
+        }
+        if c.is_ascii_digit() {
+            return Some(DIGITS[(c - b'0') as usize])
+        }
+    }
+    if let Some(num) = n.strip_prefix('f').and_then(|num| num.parse::<usize>().ok()) {
+        if (1..=12).contains(&num) {
+            return Some(FUNCTION_KEYS[num - 1])
+        }
+    }
+    Some(match n.as_str() {
+        "enter" | "return" => Key::Return,
+        "esc" | "escape" => Key::Escape,
+        "space" => Key::Space,
+        "up" => Key::UpArrow,
+        "down" => Key::DownArrow,
+        "left" => Key::LeftArrow,
+        "right" => Key::RightArrow,
+        "tab" => Key::Tab,
+        "backspace" => Key::Backspace,
+        _ => return None,
+    })
+}
+
+/// Where an input comes from.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Src {
+    Button(u8),
+    /// Axis index and direction (`true` = positive).
+    Axis(u8, bool),
+    /// One of SDL's `SDL_HAT_*` bits.
+    Hat(u8),
+}
+
+const SRC_AXIS: u32 = 2000;
+const SRC_HAT: u32 = 1000;
+const SRC_TAP: u32 = 5000;
+const SRC_KEYBOARD: u32 = 10000;
+/// Set on the source id of anything pressed while the shift button is held.
+const LAYER_BIT: u32 = 1 << 20;
+
+impl Src {
+    fn id(self) -> u32 {
+        match self {
+            Src::Button(b) => u32::from(b),
+            Src::Hat(bit) => SRC_HAT + u32::from(bit),
+            Src::Axis(a, positive) => SRC_AXIS + u32::from(a) * 2 + u32::from(positive),
+        }
+    }
+}
+
+fn parse_src(text: &str) -> Option<Src> {
+    match text.trim() {
+        "hat-up" => return Some(Src::Hat(sdl2lite::SDL_HAT_UP)),
+        "hat-down" => return Some(Src::Hat(sdl2lite::SDL_HAT_DOWN)),
+        "hat-left" => return Some(Src::Hat(sdl2lite::SDL_HAT_LEFT)),
+        "hat-right" => return Some(Src::Hat(sdl2lite::SDL_HAT_RIGHT)),
+        _ => (),
+    }
+    let t = text.trim();
+    if let Some(n) = t.strip_prefix('b') {
+        return n.parse::<u8>().ok().map(Src::Button)
+    }
+    if let Some(rest) = t.strip_prefix('a') {
+        let (num, positive) = if let Some(n) = rest.strip_suffix('+') {
+            (n, true)
+        } else if let Some(n) = rest.strip_suffix('-') {
+            (n, false)
+        } else {
+            return None
+        };
+        return num.parse::<u8>().ok().map(|n| Src::Axis(n, positive))
+    }
+    None
+}
+
+struct Binding {
+    src: Src,
+    /// Only active while the shift button is held.
+    shifted: bool,
+    key: Key,
+}
+
+/// Gamepad -> key table.
+struct Controls {
+    bindings: Vec<Binding>,
+    /// Button that switches to the second layer.
+    shift: Option<u8>,
+}
+
+impl Controls {
+    fn parse(text: &str, origin: &str) -> Self {
+        let mut c = Self { bindings: Vec::new(), shift: None };
+        for line in text.lines() {
+            let line = line.split(['#', ';']).next().unwrap_or("").trim();
+            let Some((lhs, rhs)) = line.split_once('=') else { continue };
+            let (lhs, rhs) = (lhs.trim().to_ascii_lowercase(), rhs.trim());
+
+            if lhs == "shift" {
+                match parse_src(&rhs.to_ascii_lowercase()) {
+                    Some(Src::Button(b)) => c.shift = Some(b),
+                    _ => eprintln!("[controls] {}: 'shift' debe ser un boton (b<N>): {}", origin, line),
+                }
+                continue
+            }
+
+            let (shifted, lhs) = match lhs.strip_prefix("shift+") {
+                Some(rest) => (true, rest.trim()),
+                None => (false, lhs.as_str()),
+            };
+            let Some(src) = parse_src(lhs) else {
+                eprintln!("[controls] {}: entrada no entendida: {}", origin, line);
+                continue
+            };
+            let Some(key) = parse_key(rhs) else {
+                eprintln!("[controls] {}: tecla desconocida: {}", origin, rhs);
+                continue
+            };
+            c.bindings.push(Binding { src, shifted, key });
+        }
+        c
+    }
+
+    /// Reads the file named by `TRIMUI_CONTROLS` (default `controls.ini`). If it is missing or has
+    /// no valid line, the built-in table is used.
+    fn load() -> Self {
+        let path = std::env::var("TRIMUI_CONTROLS").unwrap_or_else(|_| "controls.ini".to_string());
+        if let Ok(text) = std::fs::read_to_string(&path) {
+            let c = Self::parse(&text, &path);
+            if !c.bindings.is_empty() {
+                eprintln!("[controls] cargado {}: {} asignaciones, shift = {:?}", path, c.bindings.len(), c.shift);
+                return c
+            }
+            eprintln!("[controls] {} no tiene ninguna linea valida; se usan los controles por defecto", path);
+        }
+        let c = Self::parse(DEFAULT_INI, "(por defecto)");
+        eprintln!("[controls] controles por defecto: {} asignaciones, shift = {:?}", c.bindings.len(), c.shift);
+        c
+    }
+
+    fn keys_for(&self, src: Src, shifted: bool) -> Vec<Key> {
+        self.bindings.iter().filter(|b| b.src == src && b.shifted == shifted).map(|b| b.key).collect()
+    }
+}
+
+/// Which sources are holding which keys, so that two sources on the same key do not release it
+/// early, and one source can hold several keys.
+struct Held {
+    sources: Vec<(u32, Key)>,
+}
+
+impl Held {
+    fn press(&mut self, source: u32, key: Key, out: &mut Vec<Event>) {
+        if self.sources.iter().any(|(s, k)| *s == source && *k == key) {
+            return
+        }
+        let already = self.sources.iter().any(|(_, k)| *k == key);
+        self.sources.push((source, key));
+        if !already {
+            out.push(Event::KeyboardDown(key));
+        }
+    }
+
+    fn release(&mut self, source: u32, out: &mut Vec<Event>) {
+        let mut released: Vec<Key> = Vec::new();
+        self.sources.retain(|(s, k)| {
+            if *s == source {
+                released.push(*k);
+                false
+            } else {
+                true
+            }
+        });
+        for key in released {
+            if !self.sources.iter().any(|(_, k)| *k == key) {
+                out.push(Event::KeyboardUp(key));
+            }
+        }
+    }
+}
+
+const AXIS_THRESHOLD: i16 = 12000;
+
+struct Input {
+    controls: Controls,
+    held: Held,
+    hat: u8,
+    axis_pos: [bool; 16],
+    axis_neg: [bool; 16],
+    shift_down: bool,
+    /// Something else was pressed while shift was held (so releasing it is not a "tap").
+    shift_used: bool,
+    /// A tap key is being held for one frame and must be released on the next poll.
+    tap_pending: bool,
+    debug: bool,
+}
+
+impl Input {
+    fn new() -> Self {
+        Self {
+            controls: Controls::load(),
+            held: Held { sources: Vec::new() },
+            hat: 0,
+            axis_pos: [false; 16],
+            axis_neg: [false; 16],
+            shift_down: false,
+            shift_used: false,
+            tap_pending: false,
+            debug: std::env::var_os("TRIMUI_INPUT_DEBUG").is_some(),
+        }
+    }
+
+    /// Call once at the start of every poll.
+    fn begin_frame(&mut self, out: &mut Vec<Event>) {
+        if self.tap_pending {
+            self.tap_pending = false;
+            self.held.release(SRC_TAP, out);
+        }
+    }
+
+    /// An input went down or up: turn it into key events through the right layer.
+    fn activate(&mut self, src: Src, down: bool, out: &mut Vec<Event>) {
+        if let (Src::Button(b), Some(shift)) = (src, self.controls.shift) {
+            if b == shift {
+                if down {
+                    self.shift_down = true;
+                    self.shift_used = false;
+                } else {
+                    self.shift_down = false;
+                    if !self.shift_used {
+                        // A tap: send the shift button's own key for one frame.
+                        for key in self.controls.keys_for(src, false) {
+                            self.held.press(SRC_TAP, key, out);
+                            self.tap_pending = true;
+                        }
+                    }
+                }
+                return
+            }
+        }
+
+        let id = src.id();
+        if down {
+            let shifted = self.shift_down;
+            if shifted {
+                self.shift_used = true;
+            }
+            let source = if shifted { id | LAYER_BIT } else { id };
+            for key in self.controls.keys_for(src, shifted) {
+                self.held.press(source, key, out);
+            }
+        } else {
+            // Release whichever layer it was pressed in.
+            self.held.release(id, out);
+            self.held.release(id | LAYER_BIT, out);
+        }
+    }
+
+    fn button_event(&mut self, index: u8, down: bool, out: &mut Vec<Event>) {
+        if self.debug {
+            eprintln!("[input] boton {} {}", index, if down { "abajo" } else { "arriba" });
+        }
+        self.activate(Src::Button(index), down, out);
+    }
+
+    fn hat_event(&mut self, value: u8, out: &mut Vec<Event>) {
+        if self.debug {
+            eprintln!("[input] hat valor {}", value);
+        }
+        for bit in [sdl2lite::SDL_HAT_UP, sdl2lite::SDL_HAT_RIGHT, sdl2lite::SDL_HAT_DOWN, sdl2lite::SDL_HAT_LEFT] {
+            let (was, is) = (self.hat & bit != 0, value & bit != 0);
+            if is != was {
+                self.activate(Src::Hat(bit), is, out);
+            }
+        }
+        self.hat = value;
+    }
+
+    fn axis_event(&mut self, axis: u8, value: i16, out: &mut Vec<Event>) {
+        let a = axis as usize;
+        if a >= self.axis_pos.len() {
+            return
+        }
+        let (pos, neg) = (value > AXIS_THRESHOLD, value < -AXIS_THRESHOLD);
+        if pos != self.axis_pos[a] {
+            self.axis_pos[a] = pos;
+            if self.debug {
+                eprintln!("[input] eje {}+ {}", axis, if pos { "activo" } else { "reposo" });
+            }
+            self.activate(Src::Axis(axis, true), pos, out);
+        }
+        if neg != self.axis_neg[a] {
+            self.axis_neg[a] = neg;
+            if self.debug {
+                eprintln!("[input] eje {}- {}", axis, if neg { "activo" } else { "reposo" });
+            }
+            self.activate(Src::Axis(axis, false), neg, out);
+        }
+    }
+
+    fn keyboard(&mut self, scancode: u32, down: bool, out: &mut Vec<Event>) {
+        // SDL scancodes: 4..=29 are A..Z, 30..=38 are 1..9.
+        let key = match scancode {
+            4..=29 => Some(LETTERS[(scancode - 4) as usize]),
+            30..=38 => Some(DIGITS[(scancode - 29) as usize]),
+            40 => Some(Key::Return),
+            41 => Some(Key::Escape),
+            44 => Some(Key::Space),
+            79 => Some(Key::RightArrow),
+            80 => Some(Key::LeftArrow),
+            81 => Some(Key::DownArrow),
+            82 => Some(Key::UpArrow),
+            _ => None,
+        };
+        if let Some(key) = key {
+            let source = SRC_KEYBOARD + scancode;
+            if down {
+                self.held.press(source, key, out);
+            } else {
+                self.held.release(source, out);
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Connection / Window
+// ---------------------------------------------------------------------------------------------
+
+struct Shared {
+    joysticks: Vec<usize>,
+}
+
+static SHARED: OnceLock<Mutex<Shared>> = OnceLock::new();
+
+pub struct Connection;
+
+impl Connection {
+    pub(crate) fn new() -> Result<Self, Error> {
+        let sdl = sdl()?;
+        let flags = sdl2lite::SDL_INIT_VIDEO | sdl2lite::SDL_INIT_JOYSTICK | sdl2lite::SDL_INIT_EVENTS;
+        if unsafe { (sdl.init_sub_system)(flags) } != 0 {
+            return Err(sdl_err("SDL_InitSubSystem", sdl))
+        }
+        let shared = SHARED.get_or_init(|| Mutex::new(Shared { joysticks: Vec::new() }));
+        let mut shared = shared.lock().unwrap();
+        let count = unsafe { (sdl.num_joysticks)() };
+        for i in 0..count.max(0) {
+            let js = unsafe { (sdl.joystick_open)(i) };
+            if !js.is_null() {
+                let name = unsafe { std::ffi::CStr::from_ptr((sdl.joystick_name)(js)) };
+                eprintln!("[input] mando {}: {}", i, name.to_string_lossy());
+                shared.joysticks.push(js as usize);
+            }
+        }
+        Ok(Self)
+    }
+
+    pub(crate) fn xscreenid(&self) -> u32 {
+        0
+    }
+
+    pub(crate) fn xdisplay(&self) -> *mut Display {
+        std::ptr::null_mut()
+    }
+}
+
+pub struct Window {
+    sdl: &'static Sdl,
+    handle: *mut c_void,
+    buffer: Vec<Event>,
+    input: Input,
+    first_poll: bool,
+}
+
+// SAFETY: the window is only ever driven from the thread that owns the game.
+unsafe impl Send for Window {}
+unsafe impl Sync for Window {}
+
+impl Window {
+    pub(crate) fn new(builder: Builder) -> Result<Self, Error> {
+        let sdl = sdl()?;
+        let title = CString::new(builder.title.replace('\0', "")).unwrap_or_default();
+
+        // The loading screen may already have made the window (and the GL context); reuse it.
+        let handle = match sdl2lite::splash::window() {
+            Some(h) => {
+                unsafe { (sdl.set_window_title)(h, title.as_ptr()) };
+                h
+            },
+            None => sdl2lite::create_gl_window(sdl, &builder.title).map_err(|e| Error::Text(e.into()))?,
+        };
+
+        let (mut w, mut h): (c_int, c_int) = (0, 0);
+        unsafe { (sdl.gl_get_drawable_size)(handle, &mut w, &mut h) };
+        if w <= 0 || h <= 0 {
+            unsafe { (sdl.get_window_size)(handle, &mut w, &mut h) };
+        }
+        WIN_W.store(w.max(0) as u32, Ordering::Relaxed);
+        WIN_H.store(h.max(0) as u32, Ordering::Relaxed);
+        let driver = unsafe { (sdl.get_current_video_driver)() };
+        if !driver.is_null() {
+            eprintln!(
+                "[video] SDL driver {:?}, ventana {}x{}",
+                unsafe { std::ffi::CStr::from_ptr(driver as *const c_char) },
+                w,
+                h
+            );
+        }
+
+        Ok(Self { sdl, handle, buffer: Vec::new(), input: Input::new(), first_poll: true })
+    }
+
+    pub(crate) fn events(&self) -> &[Event] {
+        &self.buffer
+    }
+
+    pub(crate) fn poll_events(&mut self) {
+        self.buffer.clear();
+        self.input.begin_frame(&mut self.buffer);
+        let sdl = self.sdl;
+
+        if self.first_poll {
+            // Tell the game the real size right away, so it does not start from the room's size.
+            self.first_poll = false;
+            let (w, h) = window_size();
+            self.buffer.push(Event::Resize((w.min(u16::MAX as u32) as u16, h.min(u16::MAX as u32) as u16)));
+        }
+
+        let mut ev = sdl2lite::Event::zeroed();
+        while unsafe { (sdl.poll_event)(&mut ev) } != 0 {
+            match ev.kind() {
+                sdl2lite::SDL_QUIT => self.buffer.push(Event::CloseRequest),
+                sdl2lite::SDL_WINDOWEVENT => match ev.u8_at(12) {
+                    sdl2lite::SDL_WINDOWEVENT_SIZE_CHANGED => {
+                        let (w, h) = (ev.i32_at(16).max(0), ev.i32_at(20).max(0));
+                        WIN_W.store(w as u32, Ordering::Relaxed);
+                        WIN_H.store(h as u32, Ordering::Relaxed);
+                        self.buffer.push(Event::Resize((w.min(u16::MAX as i32) as u16, h.min(u16::MAX as i32) as u16)));
+                    },
+                    sdl2lite::SDL_WINDOWEVENT_FOCUS_GAINED => self.buffer.push(Event::Focus(true)),
+                    sdl2lite::SDL_WINDOWEVENT_FOCUS_LOST => self.buffer.push(Event::Focus(false)),
+                    sdl2lite::SDL_WINDOWEVENT_CLOSE => self.buffer.push(Event::CloseRequest),
+                    _ => (),
+                },
+                sdl2lite::SDL_KEYDOWN => {
+                    // ev.u8_at(13) is `repeat`: the game does its own repeat handling.
+                    if ev.u8_at(13) == 0 {
+                        self.input.keyboard(ev.u32_at(16), true, &mut self.buffer);
+                    }
+                },
+                sdl2lite::SDL_KEYUP => self.input.keyboard(ev.u32_at(16), false, &mut self.buffer),
+                sdl2lite::SDL_JOYBUTTONDOWN => self.input.button_event(ev.u8_at(12), true, &mut self.buffer),
+                sdl2lite::SDL_JOYBUTTONUP => self.input.button_event(ev.u8_at(12), false, &mut self.buffer),
+                sdl2lite::SDL_JOYHATMOTION => self.input.hat_event(ev.u8_at(13), &mut self.buffer),
+                sdl2lite::SDL_JOYAXISMOTION => self.input.axis_event(ev.u8_at(12), ev.i16_at(16), &mut self.buffer),
+                sdl2lite::SDL_JOYDEVICEADDED => {
+                    let index = ev.i32_at(8);
+                    let js = unsafe { (sdl.joystick_open)(index) };
+                    if !js.is_null() {
+                        if let Some(shared) = SHARED.get() {
+                            shared.lock().unwrap().joysticks.push(js as usize);
+                        }
+                    }
+                },
+                _ => (),
+            }
+        }
+    }
+
+    pub(crate) fn set_maximised(&self, _maximised: bool) {}
+    pub(crate) fn set_position(&self, _position: (i16, i16)) {}
+    pub(crate) fn set_borderless(&self, _borderless: bool) {}
+    pub(crate) fn set_resizable(&self, _resizable: bool) {}
+    pub(crate) fn set_size(&self, _size: (u16, u16)) {}
+    pub(crate) fn set_title(&self, title: &str) {
+        if let Ok(title) = CString::new(title.replace('\0', "")) {
+            unsafe { (self.sdl.set_window_title)(self.handle, title.as_ptr()) };
+        }
+    }
+    pub(crate) fn set_visible(&self, _visible: bool) {}
+
+    /// The raw `SDL_Window*`, for creating the GL context.
+    pub(crate) fn xid(&self) -> *mut c_void {
+        self.handle
+    }
+}
+
+impl Drop for Window {
+    fn drop(&mut self) {
+        unsafe { (self.sdl.destroy_window)(self.handle) };
+    }
+}
